# Server-only — only needed when GOLDAPI_ENABLED=true
GOLDAPI_NET_KEY=

# false = free gold-api.com | true = goldapi.net (falls back if quota exceeded)
GOLDAPI_ENABLED=false

# Legacy markup (unused on bid/ask screen; kept for older calc helpers)
NEXT_PUBLIC_PRICE_MARKUP_USD=2

# Display bid = API bid − this. Display ask = API ask + this.
NEXT_PUBLIC_BID_OFFSET_USD=1
NEXT_PUBLIC_ASK_OFFSET_USD=2

# Client poll interval in ms
NEXT_PUBLIC_REFRESH_INTERVAL_MS=5000

# TV / no-JS full-page reload (seconds). 0 = off.
NEXT_PUBLIC_META_REFRESH_SEC=30
